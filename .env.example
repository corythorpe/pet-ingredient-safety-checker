# Pet Ingredient Safety Checker - Environment Variables Template
# Copy this file to .env and fill in your actual values

# DigitalOcean Configuration (REQUIRED for AI-powered analysis)
DIGITALOCEAN_TOKEN=your_digitalocean_token_here

# DigitalOcean GenAI Agent Configuration (REQUIRED)
# Use 'doctl genai agent list' to find your actual agent IDs
DIGITALOCEAN_GENAI_RESEARCH_AGENT_ID=your_research_agent_id
DIGITALOCEAN_GENAI_RISK_AGENT_ID=your_risk_agent_id
DIGITALOCEAN_GENAI_FACTCHECK_AGENT_ID=your_factcheck_agent_id
DIGITALOCEAN_GENAI_PROJECT_ID=your_project_id
DIGITALOCEAN_GENAI_MODEL_ID=your_model_id
DIGITALOCEAN_GENAI_REGION=tor1
DIGITALOCEAN_GENAI_INFERENCE_URL=https://inference.do-ai.run/v1
DIGITALOCEAN_GENAI_STREAM_URL=https://stream.do-ai.run

# Cache Configuration
CACHE_DURATION_DAYS=15

# Flask Configuration
FLASK_ENV=development
PORT=5000

# Security
SECRET_KEY=dev_secret_key_change_in_production

# Optional: Set to 'true' to require GenAI configuration (will fail if not configured)
# Leave as 'false' to allow fallback mode for development/testing
REQUIRE_GENAI=false
